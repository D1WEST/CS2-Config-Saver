<Window x:Class="CS2ConfigSaver.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="How it works" 
        Height="470" Width="570"
        WindowStyle="None"                  
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"               
        Topmost="True"                      
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" 
                      ResizeBorderThickness="5" 
                      GlassFrameThickness="0" 
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Стили для кнопок в окне помощи -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252528"/>
            <Setter Property="Foreground" Value="#00FF66"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="BorderBrush" Value="#00FF66"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border x:Name="HoverOverlay" Background="#FFFFFF" Opacity="0" CornerRadius="3"/>
                                <Border x:Name="PressedOverlay" Background="#000000" Opacity="0" CornerRadius="3"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.15"/>
                                <Setter Property="Background" Value="#00FF66"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressedOverlay" Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF4A4A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#18181C" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="12">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ШАПКА ОКНА -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <TextBlock x:Name="HelpTitleText" Text="How it works:" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                <Button Content="❌" Width="24" Height="24" HorizontalAlignment="Right" Style="{StaticResource CloseButtonStyle}" Click="Close_Click"/>
            </Grid>

            <!-- СПИСОК ПУНКТОВ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Шаг 1 (Запуск игры) -->
                    <DockPanel LastChildFill="True" Margin="0,4">
                        <Button x:Name="BtnRunStep1" DockPanel.Dock="Left" Content="Run" Style="{StaticResource ActionButtonStyle}" Click="BtnRunStep1_Click"/>
                        <TextBlock x:Name="TxtStep1" Text="1. Launch CS2." Foreground="#BBBBBB" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>

                    <!-- Шаг 2 (Ввод команды host_writeconfig) -->
                    <StackPanel Margin="0,6">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BtnRunStep2" DockPanel.Dock="Left" Content="Run" Style="{StaticResource ActionButtonStyle}" Click="BtnRunStep2_Click"/>
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtStep2" Text="2. Write " Foreground="#BBBBBB" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Background="#2D2D30" CornerRadius="4" Padding="6,3" Cursor="Hand" MouseLeftButtonDown="CmdBlock_MouseLeftButtonDown" ToolTip="Click to copy!">
                                        <TextBlock x:Name="TxtStep3Cmd" Text="host_writeconfig YourConfigName" Foreground="#00FF66" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="CopiedTooltip" Text="Copied!" Foreground="#00FF66" FontSize="10" FontWeight="Bold" Visibility="Collapsed" Margin="95,2,0,0"/>
                    </StackPanel>

                    <!-- Шаг 3 (Поиск папок Steam) -->
                    <DockPanel LastChildFill="True" Margin="0,4">
                        <Button x:Name="BtnRunStep3" DockPanel.Dock="Left" Content="Run" Style="{StaticResource ActionButtonStyle}" Click="BtnRunStep3_Click"/>
                        <TextBlock x:Name="TxtStep5" Text="3. Detect Steam and choose profile." Foreground="#BBBBBB" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>

                    <!-- Шаг 4 (Инфо-поле для нескольких аккаунтов) -->
                    <TextBlock x:Name="TxtStep6" Text="4. If multiple accounts, choose active." Foreground="#BBBBBB" Margin="0,4" FontSize="12"/>

                    <!-- Шаг 5 (Выбрать папку бэкапов) -->
                    <DockPanel LastChildFill="True" Margin="0,4">
                        <Button x:Name="BtnRunStep5" DockPanel.Dock="Left" Content="Run" Style="{StaticResource ActionButtonStyle}" Click="BtnRunStep5_Click"/>
                        <TextBlock x:Name="TxtStep7" Text="5. Select backup folder." Foreground="#BBBBBB" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>

                    <!-- Шаг 6 (Сохранение) -->
                    <DockPanel LastChildFill="True" Margin="0,4">
                        <Button x:Name="BtnRunStep6" DockPanel.Dock="Left" Content="Run" Style="{StaticResource ActionButtonStyle}" Click="BtnRunStep6_Click"/>
                        <TextBlock x:Name="TxtStep8" Text="6. Input config name and save." Foreground="#BBBBBB" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>

                    <!-- Шаг 7 (Добавить в CS2 с копированием exec) -->
                    <StackPanel Margin="0,6">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BtnRunStep7" DockPanel.Dock="Left" Content="Run" Style="{StaticResource ActionButtonStyle}" Click="BtnRunStep7_Click"/>
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtStep10Part1" Text="7. Add config and type " Foreground="#BBBBBB" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Background="#2D2D30" CornerRadius="4" Padding="6,3" Cursor="Hand" MouseLeftButtonDown="CmdStep10_MouseLeftButtonDown" ToolTip="Click to copy!">
                                        <TextBlock x:Name="TxtStep10Cmd" Text="exec YourConfigName" Foreground="#00FF66" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="CopiedTooltip10" Text="Copied!" Foreground="#00FF66" FontSize="10" FontWeight="Bold" Visibility="Collapsed" Margin="95,2,0,0"/>
                    </StackPanel>

                    <!-- Шаг 8 (Благодарность) -->
                    <TextBlock x:Name="TxtStep9" Text="8. Thank DIWEST!" Foreground="#BBBBBB" Margin="0,4" FontSize="12"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>