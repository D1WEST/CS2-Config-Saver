<Window x:Class="CS2ConfigSaver.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification" Height="75" Width="320"
        WindowStyle="None" 
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False" 
        Topmost="True" 
        WindowStartupLocation="Manual">
    <Border Background="#18181C" BorderBrush="#00FF66" BorderThickness="1.5" CornerRadius="10" Margin="5">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.6" ShadowDepth="2"/>
        </Border.Effect>
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Иконка копирования -->
            <TextBlock Text="📋" FontSize="22" VerticalAlignment="Center" Margin="5,0,12,0"/>
            <!-- Текст сообщения -->
            <TextBlock x:Name="MsgText" Grid.Column="1" Text="Command copied to clipboard!" Foreground="White" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>